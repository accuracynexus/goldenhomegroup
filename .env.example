# ============================================================================
# Copiar como .env y completar. El archivo .env NO se sube al repositorio.
# ============================================================================

# Secreto que firma las sesiones del panel. Generar uno propio con:
#   openssl rand -hex 32
# Si cambia, todas las sesiones abiertas se cierran (que es lo deseable).
AUTH_SECRET=

# Dominio del sitio, sin https:// ni barra final
DOMINIO=goldenhomegroup.com

# URL completa: se usa en las etiquetas canónicas y en las que ven las redes
SITE_URL=https://goldenhomegroup.com

# --- Solo para desarrollo local (tienen valores por defecto) ----------------
# DB_PATH=./data/golden.db
# UPLOADS_DIR=./uploads
